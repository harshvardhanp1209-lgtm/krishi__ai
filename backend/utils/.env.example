# Krishi AI — Environment Variables Example
# Copy this file to .env and fill in your values

# Comma-separated list of allowed CORS origins.
# Use * to allow all origins (development only).
# Example for production: https://krishiai.example.com,https://www.krishiai.example.com
ALLOWED_ORIGINS=*

# Server host and port (used when running manually, not via uvicorn CLI args)
HOST=0.0.0.0
PORT=8000
